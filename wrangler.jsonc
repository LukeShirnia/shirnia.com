{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shirnia-com",
  "compatibility_date": "2026-11-05",
  // Custom domains are managed in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./app",
    "not_found_handling": "none"
  }
}
